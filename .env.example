# Copy to .env.local for development, and add the same values in Vercel.

# Supabase → Project Settings → API. The service role key is server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Signs the login cookie. Any random string of 32+ characters:
#   openssl rand -base64 48
SESSION_SECRET=

# Reads recipe photos (Claude Sonnet).
ANTHROPIC_API_KEY=

# Turns "read it aloud" recordings into text.
OPENAI_API_KEY=
